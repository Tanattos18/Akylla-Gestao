generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  // Fase 1 · 1D: cadastro aberto aguardando confirmação do e-mail do admin
  PENDING_VERIFICATION
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  MEMBER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum LegalConsentType {
  TERMS
  PRIVACY
  DATA_PROCESSING
}

enum LegalConsentRole {
  USER
  CLIENT
}

/// Fase 1 · 1D: confirmação de e-mail do cadastro aberto. Mesmo padrão do
/// PasswordResetToken: só o hash SHA-256 é guardado; uso único; expira.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ProductUnit {
  UNIDADE
  KG
  G
  L
  ML
  CAIXA
  PACOTE
  ROLLO
}

enum StockMovementType {
  IN
  OUT
  ADJUST_POSITIVE
  ADJUST_NEGATIVE
}

enum PaymentMethod {
  CASH
  CARD
  PIX
  OTHER
  // Fase 2 · 2.2: venda a prazo (parcelas no crediário do cliente)
  CREDIARIO
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

enum CashMovementOrigin {
  MANUAL
  SALE
  SALE_CANCELMENT
  REVERSAL
  ACCOUNT
}

enum FinancialDirection {
  PAYABLE
  RECEIVABLE
}

enum FinancialStatus {
  OPEN
  PAID
  CANCELLED
}

enum FinancialOrigin {
  MANUAL
  SALE
  SUBSCRIPTION
  // Fase 2 · 2.1: comissão a pagar ao profissional
  COMMISSION
  // Fase 2 · 2.1: estorno de comissão já paga (a receber do profissional)
  COMMISSION_REVERSAL
  // Fase 2 · 2.2: parcela de venda no crediário (a receber do cliente)
  CREDIT_SALE
  // Fase 2 · 2.3: ordem de serviço concluída (a receber do cliente)
  SERVICE_ORDER
}

/// Fase 2 · 2.3 — ciclo da ordem de serviço (transições estritas)
enum ServiceOrderStatus {
  DRAFT
  QUOTE
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Fase 2 · 2.2 — situação do crediário do cliente
enum CreditAccountStatus {
  ACTIVE
  BLOCKED
}

/// Fase 2 · 2.2 — parcela do crediário (OVERDUE é marcado na leitura)
enum CreditInstallmentStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
  /// Paga e devolvida ao cliente no cancelamento da venda (auditoria bloco 4)
  REFUNDED
}

/// Fase 2 · 2.1 — quando a comissão fica devida
enum ReleasePolicy {
  ON_SALE
  ON_PAYMENT
  SPLIT_50_50
}

/// Fase 2 · 2.1 — ciclo de vida da comissão
enum CommissionStatus {
  PENDING
  RELEASED
  PAID
  CANCELLED
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  RODENT
  REPTILE
  FISH
  OTHER
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum WhatsAppConfigStatus {
  CONFIGURED
  ACTIVE
  ERROR
  DISCONNECTED
}

enum WhatsAppConsentStatus {
  OPTED_IN
  OPTED_OUT
}

enum WhatsAppConsentSource {
  MANUAL
  REPLY
  IMPORT
}

enum WhatsAppTemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

enum WhatsAppTemplateApproval {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum WhatsAppMessageStatus {
  PENDING
  PROCESSING
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum WhatsAppMessageOrigin {
  MANUAL
  SERVICE_REMINDER
  // Fase 2 · 2.3: mensagem vinculada a uma ordem de serviço (originId)
  SERVICE_ORDER
}

enum WhatsAppAttemptOutcome {
  ACCEPTED
  TRANSIENT_ERROR
  PERMANENT_ERROR
}

enum WhatsAppWebhookKind {
  STATUS
  INBOUND
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// Fase 8 — ciclo de cobrança da assinatura do SaaS
enum BillingCycle {
  MONTHLY
  YEARLY
}

/// Fase 8 — forma de pagamento registrada pelo dono da plataforma
enum PlatformPaymentMethod {
  PIX
  BOLETO
  CARD
  MERCADO_PAGO
  OTHER
}

enum TenantSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Company {
  id                      String                   @id @default(cuid())
  name                    String
  slug                    String                   @unique
  status                  CompanyStatus            @default(ACTIVE)
  /// Fase 4: perfil escolhido no onboarding (slug de OnboardingPreset)
  segment                 String?
  /// Fase 4: quando o onboarding foi concluído (null = mostrar a escolha)
  onboardingCompletedAt   DateTime?
  /// Fase 7: CNPJ (14) ou CPF (11), só dígitos; sai no comprovante
  document                String?
  /// Fase 7: telefone e endereço de uma linha para o comprovante
  phone                   String?
  address                 String?
  /// Fase 8: fim do teste grátis (null + sem assinatura = isenta, ex.: empresa do dono)
  trialEndsAt             DateTime?
  /// Fase 8: isenta de cobrança (definido pelo dono da plataforma)
  billingExempt           Boolean                  @default(false)
  /// Fase 8: suspensão manual pelo dono (status INACTIVE)
  suspendedAt             DateTime?
  suspendedReason         String?
  /// Transformação 2026-10-23: dias de atraso de um contrato até o aviso e
  /// até a pausa da entrega (só configuração; a pausa ainda não é executada)
  overdueWarnDays         Int                      @default(1)
  overduePauseDays        Int                      @default(10)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  users                   User[]
  categories              Category[]
  suppliers               Supplier[]
  products                Product[]
  stockMovements          StockMovement[]
  sales                   Sale[]
  cashSessions            CashSession[]
  cashMovements           CashMovement[]
  financialEntries        FinancialEntry[]
  clients                 Client[]
  pets                    Pet[]
  services                Service[]
  whatsappConfig          WhatsAppConfig?
  whatsappTemplates       WhatsAppTemplate[]
  whatsappMessages        WhatsAppMessage[]
  whatsappConsents        WhatsAppConsent[]
  whatsappWebhookEvents   WhatsAppWebhookEvent[]
  appointments            Appointment[]
  subscriptionPlans       SubscriptionPlan[]
  subscriptions           Subscription[]
  tenantSubscription      TenantSubscription?
  platformPayments        PlatformPayment[]
  modules                 CompanyModule[]
  importBatches           ImportBatch[]
  legalConsents           LegalConsent[]
  professionals           Professional[]
  commissionRules         CommissionRule[]
  commissions             Commission[]
  creditAccounts          CreditAccount[]
  creditInstallments      CreditInstallment[]
  serviceOrders           ServiceOrder[]
  serviceOrderItems       ServiceOrderItem[]
  serviceOrderAttachments ServiceOrderAttachment[]
  fiscalConfig            FiscalConfig?
  fiscalDocuments         FiscalDocument[]
  digitalProducts         DigitalProduct[]
  clientDeliveries        ClientDelivery[]
  deliveryCredentials     DeliveryCredential[]
  credentialAccessLogs    CredentialAccessLog[]
  siteChecks              SiteCheck[]
}

/// Módulos vendáveis. O antigo PETS saiu do produto em 2026-10-19
/// (migration 20261019180000_remove_pets_module).
enum BusinessModule {
  APPOINTMENTS
  SERVICES
  WHATSAPP
  SUBSCRIPTIONS
  COMMISSIONS
  CREDIT
  SERVICE_ORDERS
  FISCAL
}

/// Fase 3 — ambiente da emissora fiscal
enum FiscalEnvironment {
  HOMOLOGATION
  PRODUCTION
}

/// Fase 3 — tipo de documento fiscal
enum FiscalDocumentType {
  NFE
  NFCE
  NFSE
}

/// Fase 3 — situação do documento na emissora/SEFAZ
enum FiscalDocumentStatus {
  PENDING
  AUTHORIZED
  REJECTED
  CANCELLED
}

enum ImportType {
  CATEGORY
  SUPPLIER
  PRODUCT
  CLIENT
  SERVICE
}

enum ImportStatus {
  COMPLETED
  FAILED
}

model ImportBatch {
  id              String       @id @default(cuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  type            ImportType
  status          ImportStatus @default(COMPLETED)
  filename        String
  createdCount    Int          @default(0)
  skippedCount    Int          @default(0)
  errorCount      Int          @default(0)
  errors          Json?
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())

  @@index([companyId, createdAt])
}

enum CompanyModuleStatus {
  ACTIVE
  DISABLED
}

model CompanyModule {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module    BusinessModule
  status    CompanyModuleStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([companyId, module])
  @@index([companyId])
}

model User {
  id                        String                   @id @default(cuid())
  companyId                 String
  company                   Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name                      String
  /// Único em todo o sistema (login é por e-mail) — auditoria bloco 2
  email                     String                   @unique
  passwordHash              String
  role                      UserRole                 @default(MEMBER)
  status                    UserStatus               @default(ACTIVE)
  // Fase 1 · 1D: quando o e-mail foi confirmado (null = não confirmado)
  emailVerifiedAt           DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  sessions                  Session[]
  stockMovements            StockMovement[]
  salesCreated              Sale[]                   @relation("SaleCreatedBy")
  salesCancelled            Sale[]                   @relation("SaleCancelledBy")
  cashSessionsOpened        CashSession[]            @relation("CashSessionOpenedBy")
  cashSessionsClosed        CashSession[]            @relation("CashSessionClosedBy")
  cashMovements             CashMovement[]
  movementsReversed         CashMovement[]           @relation("MovementReversedBy")
  financialEntriesCreated   FinancialEntry[]
  whatsappTemplatesCreated  WhatsAppTemplate[]
  whatsappConsentsUpdated   WhatsAppConsent[]
  whatsappMessagesCreated   WhatsAppMessage[]        @relation("WhatsAppMessageCreatedBy")
  whatsappMessagesCancelled WhatsAppMessage[]        @relation("WhatsAppMessageCancelledBy")
  appointmentsCreated       Appointment[]            @relation("AppointmentCreatedBy")
  appointmentsCancelled     Appointment[]            @relation("AppointmentCancelledBy")
  subscriptionPlansCreated  SubscriptionPlan[]       @relation("SubscriptionPlanCreatedBy")
  subscriptionsCreated      Subscription[]           @relation("SubscriptionCreatedBy")
  subscriptionsCancelled    Subscription[]           @relation("SubscriptionCancelledBy")
  tenantSubscriptionChanged TenantSubscription[]     @relation("TenantSubscriptionChangedBy")
  importBatches             ImportBatch[]
  legalConsents             LegalConsent[]
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens   EmailVerificationToken[]
  serviceOrdersCreated      ServiceOrder[]           @relation("ServiceOrderCreatedBy")
  fiscalDocumentsRequested  FiscalDocument[]         @relation("FiscalDocumentRequestedBy")
  deliveryCredentials       DeliveryCredential[]
  credentialAccessLogs      CredentialAccessLog[]
  twoFactorSecret           String?
  twoFactorEnabled          Boolean                  @default(false)

  @@unique([companyId, email])
  @@index([companyId, status])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id               String           @id @default(cuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name             String
  nameKey          String
  description      String?
  status           RecordStatus     @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  products         Product[]
  financialEntries FinancialEntry[]
  commissionRules  CommissionRule[]

  @@unique([companyId, nameKey])
  @@index([companyId, status])
}

model Supplier {
  id               String           @id @default(cuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name             String
  document         String?
  email            String?
  phone            String?
  notes            String?
  status           RecordStatus     @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  products         Product[]
  financialEntries FinancialEntry[]

  @@index([companyId, status])
  @@index([companyId, name])
}

model Client {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name             String
  nameKey          String
  phone            String?
  mobile           String?
  email            String?
  cpf              String?
  street           String?
  number           String?
  complement       String?
  district         String?
  city             String?
  state            String?
  zip              String?
  notes            String?
  status           RecordStatus      @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  pets             Pet[]
  sales            Sale[]
  whatsappConsent  WhatsAppConsent?
  whatsappMessages WhatsAppMessage[]
  appointments     Appointment[]
  subscriptions    Subscription[]
  financialEntries FinancialEntry[]
  legalConsents    LegalConsent[]
  creditAccount    CreditAccount?
  serviceOrders    ServiceOrder[]
  deliveries       ClientDelivery[]

  @@index([companyId, nameKey])
  @@index([companyId, status])
  @@index([companyId, name])
  @@index([companyId, phone])
  @@index([companyId, mobile])
  @@index([companyId, email])
  @@index([companyId, createdAt])
}

model LegalConsent {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId   String?
  client     Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  role       LegalConsentRole
  type       LegalConsentType
  version    String
  acceptedAt DateTime         @default(now())
  ip         String?

  @@index([companyId, acceptedAt])
  @@index([userId])
  @@index([clientId])
}

/// LEGADO (2026-10-19): o módulo Pets saiu do produto. A tabela fica só para
/// preservar dados antigos (exportação e anonimização LGPD); sem API nem telas.
model Pet {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name         String
  species      PetSpecies
  breed        String?
  sex          PetSex        @default(UNKNOWN)
  birthDate    DateTime?
  weight       Decimal?      @db.Decimal(6, 2)
  color        String?
  notes        String?
  status       RecordStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@index([companyId, status])
  @@index([companyId, name])
  @@index([clientId])
  @@index([companyId, createdAt])
}

model Service {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name              String
  nameKey           String
  description       String?
  durationMinutes   Int?
  price             Decimal            @db.Decimal(12, 2)
  status            RecordStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  appointments      Appointment[]
  serviceOrderItems ServiceOrderItem[]

  @@unique([companyId, nameKey])
  @@index([companyId, status])
  @@index([companyId, name])
}

model Appointment {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId          String
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// LEGADO: não é mais gravado (módulo Pets removido em 2026-10-19)
  petId             String?
  pet               Pet?              @relation(fields: [petId], references: [id], onDelete: Restrict)
  serviceId         String
  service           Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  startAt           DateTime
  endAt             DateTime
  startLocal        String
  durationMinutes   Int
  status            AppointmentStatus @default(SCHEDULED)
  notes             String?
  cancelReason      String?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?             @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  createdByUserId   String
  createdBy         User              @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([companyId, startLocal])
  @@index([companyId, status, startAt])
  @@index([clientId])
  @@index([petId])
}

model Product {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  categoryId        String?
  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId        String?
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name              String
  description       String?
  sku               String?
  barcode           String?
  unit              ProductUnit        @default(UNIDADE)
  costPrice         Decimal            @default(0) @db.Decimal(12, 2)
  salePrice         Decimal            @default(0) @db.Decimal(12, 2)
  stockQuantity     Decimal            @default(0) @db.Decimal(12, 3)
  minimumStock      Decimal            @default(0) @db.Decimal(12, 3)
  status            RecordStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  movements         StockMovement[]
  saleItems         SaleItem[]
  commissionRules   CommissionRule[]
  serviceOrderItems ServiceOrderItem[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, status])
  @@index([companyId, name])
}

model StockMovement {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type            StockMovementType
  quantity        Decimal           @db.Decimal(12, 3)
  notes           String?
  reference       String?
  createdByUserId String
  createdBy       User              @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())

  @@index([companyId, productId, createdAt])
  @@index([companyId, createdAt])
}

model Sale {
  id                 String              @id @default(cuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId           String?
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  receiptCode        String
  clientRequestId    String?
  status             SaleStatus          @default(COMPLETED)
  subtotal           Decimal             @db.Decimal(12, 2)
  discount           Decimal             @default(0) @db.Decimal(12, 2)
  total              Decimal             @db.Decimal(12, 2)
  paymentMethod      PaymentMethod
  paymentNote        String?
  createdByUserId    String
  createdBy          User                @relation("SaleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledBy        User?               @relation("SaleCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelReason       String?
  cashSessionId      String?
  cashSession        CashSession?        @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  // Fase 2 · 2.1: profissional/vendedor responsável (base da comissão)
  professionalId     String?
  professional       Professional?       @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  items              SaleItem[]
  cashMovements      CashMovement[]
  commissions        Commission[]
  creditInstallments CreditInstallment[]
  fiscalDocuments    FiscalDocument[]

  @@unique([companyId, receiptCode])
  @@unique([companyId, clientRequestId])
  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, clientId])
  @@index([companyId, professionalId])
}

/// Fase 2 · 2.1 — profissional que recebe comissão (vendedor, técnico,
/// cabeleireiro…). Não é usuário do sistema; nunca é apagado (status).
model Professional {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name              String
  nameKey           String
  document          String?
  /// Percentual padrão quando nenhuma regra se aplica (0–100)
  commissionDefault Decimal?         @db.Decimal(5, 2)
  status            RecordStatus     @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  rules             CommissionRule[]
  commissions       Commission[]
  sales             Sale[]
  serviceOrders     ServiceOrder[]

  @@unique([companyId, nameKey])
  @@index([companyId, status])
}

/// Fase 2 · 2.1 — regra de comissão. Alvo opcional: profissional e/ou
/// produto ou categoria. Precedência (mais específica vence): produto >
/// categoria > regra só do profissional > `commissionDefault` > regra geral.
model CommissionRule {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  percentage     Decimal       @db.Decimal(5, 2)
  releasePolicy  ReleasePolicy @default(ON_SALE)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId, active])
  @@index([companyId, professionalId])
}

/// Fase 2 · 2.1 — comissão de UM profissional em UMA venda (soma das
/// linhas; o detalhamento por item fica em `lines`). Valores calculados
/// no servidor; histórico imutável (cancelamento/estorno auditados).
model Commission {
  id               String           @id @default(cuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  saleId           String?
  sale             Sale?            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  /// Fase 2 · 2.3: comissão de ordem de serviço concluída
  serviceOrderId   String?
  serviceOrder     ServiceOrder?    @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  professionalId   String
  professional     Professional     @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  baseAmount       Decimal          @db.Decimal(12, 2)
  /// Percentual efetivo (amount / base), para exibição
  percentage       Decimal          @db.Decimal(5, 2)
  amount           Decimal          @db.Decimal(12, 2)
  releasePolicy    ReleasePolicy    @default(ON_SALE)
  status           CommissionStatus @default(PENDING)
  /// [{ saleItemId, productName, base, percentage, amount, ruleId, source }]
  lines            Json
  releasedAt       DateTime?
  paidAt           DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  financialEntryId String?          @unique
  reversalEntryId  String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([saleId, professionalId])
  @@unique([serviceOrderId, professionalId])
  @@index([companyId, status, createdAt])
  @@index([companyId, professionalId, createdAt])
}

/// Fase 2 · 2.2 — crediário do cliente: limite aprovado pelo ADMIN e saldo
/// devedor (soma das parcelas em aberto/vencidas), mantido na mesma
/// transação de cada venda/pagamento/cancelamento.
model CreditAccount {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// um crediário por cliente (o cliente já pertence a uma única empresa)
  clientId     String              @unique
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  creditLimit  Decimal             @db.Decimal(12, 2)
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  status       CreditAccountStatus @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  installments CreditInstallment[]

  @@index([companyId, status])
}

/// Fase 2 · 2.2 — parcela de uma venda no crediário. Valor e vencimento
/// calculados pelo servidor; nunca apagada (paga/cancelada com histórico).
model CreditInstallment {
  id                String                  @id @default(cuid())
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creditAccountId   String
  creditAccount     CreditAccount           @relation(fields: [creditAccountId], references: [id], onDelete: Restrict)
  saleId            String
  sale              Sale                    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  number            Int
  totalInstallments Int
  dueDate           DateTime
  amount            Decimal                 @db.Decimal(12, 2)
  status            CreditInstallmentStatus @default(OPEN)
  paidAt            DateTime?
  cancelledAt       DateTime?
  refundedAt        DateTime?
  financialEntryId  String?                 @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([saleId, number])
  @@index([companyId, status, dueDate])
  @@index([creditAccountId, status])
}

/// Fase 2 · 2.3 — ordem de serviço. Número sequencial por empresa; totais
/// calculados no servidor; itens travados após a aprovação; nunca apagada.
model ServiceOrder {
  id               String                   @id @default(cuid())
  companyId        String
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  number           Int
  clientId         String
  client           Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professionalId   String?
  professional     Professional?            @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  status           ServiceOrderStatus       @default(DRAFT)
  /// Resumo: equipamento/serviço e problema relatado
  title            String
  notes            String?
  subtotal         Decimal                  @default(0) @db.Decimal(12, 2)
  discount         Decimal                  @default(0) @db.Decimal(12, 2)
  total            Decimal                  @default(0) @db.Decimal(12, 2)
  openedAt         DateTime                 @default(now())
  quotedAt         DateTime?
  approvedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  financialEntryId String?                  @unique
  createdByUserId  String
  createdBy        User                     @relation("ServiceOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  items            ServiceOrderItem[]
  attachments      ServiceOrderAttachment[]
  commissions      Commission[]
  fiscalDocuments  FiscalDocument[]

  @@unique([companyId, number])
  @@index([companyId, status, openedAt])
  @@index([companyId, clientId])
}

/// Fase 3 — configuração fiscal da empresa. Segredos (token da emissora,
/// certificado A1 e senha) ficam CIFRADOS (AES-256-GCM, FISCAL_ENCRYPTION_KEY)
/// e nunca são devolvidos pela API.
model FiscalConfig {
  id                           String            @id @default(cuid())
  companyId                    String            @unique
  company                      Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// mock | mock-async | mock-reject | <integradora real>
  provider                     String            @default("mock")
  apiTokenEncrypted            String?
  cnpj                         String?
  certificateEncrypted         String?
  certificatePasswordEncrypted String?
  certificateSubject           String?
  certificateValidTo           DateTime?
  environment                  FiscalEnvironment @default(HOMOLOGATION)
  active                       Boolean           @default(false)
  nfceSeries                   Int               @default(1)
  nfeSeries                    Int               @default(1)
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
}

/// Fase 3 — documento fiscal emitido por integração (sem emissor próprio).
model FiscalDocument {
  id                 String               @id @default(cuid())
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  saleId             String?
  sale               Sale?                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  serviceOrderId     String?
  serviceOrder       ServiceOrder?        @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  type               FiscalDocumentType
  status             FiscalDocumentStatus @default(PENDING)
  environment        FiscalEnvironment
  number             Int
  series             Int
  amount             Decimal              @db.Decimal(12, 2)
  accessKey          String?
  protocol           String?
  xml                String?
  danfeUrl           String?
  issuedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  rejectionReason    String?
  /// id do documento na emissora (webhook); único entre todas as empresas
  gatewayDocumentId  String?              @unique
  requestedByUserId  String
  requestedBy        User                 @relation("FiscalDocumentRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([companyId, type, series, number])
  @@index([companyId, status, createdAt])
  @@index([saleId])
  @@index([serviceOrderId])
}

/// Fase 2 · 2.3 — item da OS: serviço ou produto do catálogo (preço do
/// catálogo) ou item livre (ex.: mão de obra, preço informado).
model ServiceOrderItem {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  description    String
  quantity       Decimal      @db.Decimal(12, 3)
  unitPrice      Decimal      @db.Decimal(12, 2)
  subtotal       Decimal      @db.Decimal(12, 2)

  @@index([companyId, serviceOrderId])
}

/// Fase 2 · 2.3 — anexo (jpg/png/pdf até 5 MB) guardado em disco
/// (`UPLOADS_DIR/service-orders/<companyId>/<osId>/`), nome aleatório.
model ServiceOrderAttachment {
  id               String       @id @default(cuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  serviceOrderId   String
  serviceOrder     ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  filename         String
  mimeType         String
  size             Int
  storagePath      String
  uploadedByUserId String?
  uploadedAt       DateTime     @default(now())

  @@index([companyId, serviceOrderId])
}

model SaleItem {
  id          String      @id @default(cuid())
  saleId      String
  sale        Sale        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  productSku  String?
  unit        ProductUnit
  unitPrice   Decimal     @db.Decimal(12, 2)
  quantity    Decimal     @db.Decimal(12, 3)
  subtotal    Decimal     @db.Decimal(12, 2)

  @@index([saleId])
}

model CashSession {
  id             String            @id @default(cuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status         CashSessionStatus @default(OPEN)
  initialAmount  Decimal           @db.Decimal(12, 2)
  openingNotes   String?
  openedByUserId String
  openedBy       User              @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  closedByUserId String?
  closedBy       User?             @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  closingNotes   String?
  countedAmount  Decimal?          @db.Decimal(12, 2)
  expectedAmount Decimal?          @db.Decimal(12, 2)
  difference     Decimal?          @db.Decimal(12, 2)
  movements      CashMovement[]
  sales          Sale[]

  @@index([companyId, status])
  @@index([companyId, openedAt])
}

model CashMovement {
  id               String             @id @default(cuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cashSessionId    String
  cashSession      CashSession        @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  type             CashMovementType
  origin           CashMovementOrigin
  inCash           Boolean            @default(true)
  amount           Decimal            @db.Decimal(12, 2)
  description      String
  justification    String?
  saleId           String?
  sale             Sale?              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  subscriptionId   String?
  subscription     Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  reversalOfId     String?
  reversalOf       CashMovement?      @relation("MovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals        CashMovement[]     @relation("MovementReversal")
  reversedAt       DateTime?
  reversedByUserId String?
  reversedBy       User?              @relation("MovementReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  reversalReason   String?
  createdByUserId  String
  createdBy        User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime           @default(now())
  financialEntries FinancialEntry[]

  @@unique([origin, saleId])
  @@index([companyId, createdAt])
  @@index([companyId, cashSessionId])
  @@index([companyId, saleId])
  @@index([companyId, subscriptionId])
}

model FinancialEntry {
  id              String             @id @default(cuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  direction       FinancialDirection
  description     String
  amount          Decimal            @db.Decimal(12, 2)
  dueDate         DateTime
  status          FinancialStatus    @default(OPEN)
  paidAt          DateTime?
  cancelReason    String?
  clientId        String?
  client          Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supplierId      String?
  supplier        Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  origin          FinancialOrigin    @default(MANUAL)
  originId        String?
  clientRequestId String?
  cashMovementId  String?
  cashMovement    CashMovement?      @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdBy       User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([companyId, origin, originId])
  @@unique([companyId, clientRequestId])
  @@index([companyId, status, dueDate])
  @@index([companyId, direction, status, dueDate])
  @@index([companyId, clientId])
  @@index([companyId, supplierId])
}

model SubscriptionPlan {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name            String
  nameKey         String
  description     String?
  price           Decimal        @db.Decimal(12, 2)
  durationDays    Int
  status          RecordStatus   @default(ACTIVE)
  createdByUserId String
  createdBy       User           @relation("SubscriptionPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]

  @@unique([companyId, nameKey])
  @@index([companyId, status])
  @@index([companyId, name])
}

model Subscription {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  planId            String
  plan              SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  startAt           DateTime
  endAt             DateTime
  status            SubscriptionStatus @default(ACTIVE)
  cancelReason      String?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?              @relation("SubscriptionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  createdByUserId   String
  createdBy         User               @relation("SubscriptionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  renewalCount      Int                @default(0)
  lastPaymentAt     DateTime?
  /// Transformação 2026-10-23: entrega coberta por este contrato
  deliveryId        String?
  delivery          ClientDelivery?    @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payments          CashMovement[]

  @@index([companyId, status, endAt])
  @@index([clientId])
  @@index([deliveryId])
  @@index([companyId, createdAt])
}

/// Fase 4 — perfil de onboarding (catálogo GLOBAL, sem empresa): módulos
/// que ficam ativos ao escolher o perfil. Dados de referência gravados na
/// migration `20261018230000_onboarding_presets`.
model OnboardingPreset {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  name                 String
  description          String
  defaultModules       BusinessModule[]
  defaultFiscalEnabled Boolean          @default(false)
  active               Boolean          @default(true)
  sortOrder            Int              @default(0)
  createdAt            DateTime         @default(now())
}

model TenantPlan {
  id                  String               @id @default(cuid())
  name                String
  nameKey             String               @unique
  description         String?
  priceMonthly        Decimal              @db.Decimal(12, 2)
  /// Fase 8: preço anual (null = sem opção anual)
  priceYearly         Decimal?             @db.Decimal(12, 2)
  /// Kits (Fase 8b): módulos opcionais incluídos no kit (o núcleo é sempre incluído)
  includedModules     BusinessModule[]     @default([])
  sortOrder           Int                  @default(0)
  durationDays        Int                  @default(30)
  userLimit           Int?
  clientLimit         Int?
  productLimit        Int?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenantSubscriptions TenantSubscription[]

  @@index([active])
}

model TenantSubscription {
  id                    String                   @id @default(cuid())
  companyId             String                   @unique
  company               Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  planId                String
  plan                  TenantPlan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                TenantSubscriptionStatus @default(ACTIVE)
  billingCycle          BillingCycle             @default(MONTHLY)
  /// Kits (Fase 8b): módulos avulsos contratados além do kit (combo personalizado)
  extraModules          BusinessModule[]         @default([])
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelReason          String?
  cancelledAt           DateTime?
  changedByUserId       String?
  changedBy             User?                    @relation("TenantSubscriptionChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  gateway               String?
  gatewaySubscriptionId String?                  @unique
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status, currentPeriodEnd])
}

model WhatsAppConfig {
  id                  String               @id @default(cuid())
  companyId           String               @unique
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status              WhatsAppConfigStatus @default(CONFIGURED)
  phoneNumberId       String?
  wabaId              String?
  displayName         String?
  lastError           String?
  lastHealthAt        DateTime?
  reminderTemplateId  String?
  reminderTemplate    WhatsAppTemplate?    @relation(fields: [reminderTemplateId], references: [id], onDelete: SetNull)
  reminderLeadMinutes Int                  @default(1440)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
}

model WhatsAppTemplate {
  id                String                   @id @default(cuid())
  companyId         String
  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name              String
  nameKey           String
  language          String                   @default("pt_BR")
  category          WhatsAppTemplateCategory @default(UTILITY)
  approval          WhatsAppTemplateApproval @default(PENDING_APPROVAL)
  body              String
  providerReference String?
  status            RecordStatus             @default(ACTIVE)
  createdByUserId   String?
  createdBy         User?                    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  messages          WhatsAppMessage[]
  reminderConfigs   WhatsAppConfig[]

  @@unique([companyId, nameKey])
  @@index([companyId, status])
  @@index([companyId, approval])
}

model WhatsAppConsent {
  id              String                @id @default(cuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId        String                @unique
  client          Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status          WhatsAppConsentStatus
  source          WhatsAppConsentSource
  phone           String?
  notes           String?
  updatedByUserId String?
  updatedBy       User?                 @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
  changedAt       DateTime              @default(now())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  messages        WhatsAppMessage[]

  @@index([companyId, status])
}

model WhatsAppMessage {
  id                       String                   @id @default(cuid())
  companyId                String
  company                  Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId                 String?
  client                   Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  templateId               String?
  template                 WhatsAppTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  consentId                String?
  consent                  WhatsAppConsent?         @relation(fields: [consentId], references: [id], onDelete: SetNull)
  toPhone                  String
  variables                Json?
  templateNameSnapshot     String
  templateLanguageSnapshot String
  templateBodySnapshot     String
  status                   WhatsAppMessageStatus    @default(PENDING)
  origin                   WhatsAppMessageOrigin    @default(MANUAL)
  /// Fase 2 · 2.3: id da origem (ex.: ServiceOrder) quando aplicável
  originId                 String?
  attempts                 Int                      @default(0)
  maxAttempts              Int                      @default(3)
  nextAttemptAt            DateTime?
  lastAttemptAt            DateTime?
  providerMessageId        String?                  @unique
  failureReason            String?
  failureDetail            String?
  idempotencyKey           String?
  cancelReason             String?
  cancelledByUserId        String?
  cancelledBy              User?                    @relation("WhatsAppMessageCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  createdByUserId          String?
  createdBy                User?                    @relation("WhatsAppMessageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  attemptsLog              WhatsAppMessageAttempt[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
  @@index([companyId, status, nextAttemptAt])
  @@index([clientId])
  @@index([companyId, origin, originId])
}

model WhatsAppMessageAttempt {
  id                String                 @id @default(cuid())
  messageId         String
  message           WhatsAppMessage        @relation(fields: [messageId], references: [id], onDelete: Restrict)
  attemptNumber     Int
  outcome           WhatsAppAttemptOutcome
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  httpStatus        Int?
  startedAt         DateTime               @default(now())
  finishedAt        DateTime?

  @@unique([messageId, attemptNumber])
  @@index([startedAt])
}

model WhatsAppWebhookEvent {
  id                String              @id @default(cuid())
  eventId           String              @unique
  kind              WhatsAppWebhookKind @default(OTHER)
  phoneNumberId     String?
  companyId         String?
  company           Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  providerMessageId String?
  payload           Json
  handled           Boolean             @default(false)
  receivedAt        DateTime            @default(now())

  @@index([companyId, receivedAt])
  @@index([providerMessageId])
}

/// Fase 8 — pagamentos da assinatura do SaaS registrados pelo dono da
/// plataforma (Pix, boleto, acordo) ou confirmados pelo gateway. Imutável.
model PlatformPayment {
  id           String                @id @default(cuid())
  companyId    String
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  planName     String
  /// Kits (Fase 8b): módulos avulsos pagos neste pagamento (histórico)
  extraModules BusinessModule[]      @default([])
  cycle        BillingCycle
  amount       Decimal               @db.Decimal(12, 2)
  method       PlatformPaymentMethod
  periodStart  DateTime
  periodEnd    DateTime
  note         String?
  recordedBy   String
  createdAt    DateTime              @default(now())

  @@index([companyId, createdAt])
}

/// Kits (Fase 8b) — preço mensal de cada módulo opcional, para combos
/// personalizados. Catálogo global (sem companyId), editado pelo dono.
model ModuleOffer {
  module       BusinessModule @id
  description  String
  priceMonthly Decimal        @db.Decimal(12, 2)
  active       Boolean        @default(true)
  sortOrder    Int            @default(0)
  updatedAt    DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// Transformação 2026-10-23 — clientes e produtos digitais
// ---------------------------------------------------------------------------

enum DigitalProductType {
  SITE
  PROFESSIONAL_PROFILE
  SYSTEM
  ONLINE_STORE
  HOSTING
  DOMAIN
  MAINTENANCE
}

enum DigitalBillingPeriod {
  MONTHLY
  YEARLY
}

enum DeliveryStatus {
  IN_PROGRESS
  ACTIVE
  PAUSED
  CANCELLED
}

/// Catálogo de produtos digitais vendidos pela empresa.
model DigitalProduct {
  id            String               @id @default(cuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name          String
  nameKey       String
  type          DigitalProductType
  description   String?
  defaultPrice  Decimal              @db.Decimal(12, 2)
  billingPeriod DigitalBillingPeriod @default(MONTHLY)
  status        RecordStatus         @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deliveries    ClientDelivery[]

  @@unique([companyId, nameKey])
  @@index([companyId, status])
  @@index([companyId, type])
}

/// O que foi entregue a um cliente (site, sistema, loja, domínio...).
model ClientDelivery {
  id                String               @id @default(cuid())
  companyId         String
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId          String
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  productId         String?
  product           DigitalProduct?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  name              String
  type              DigitalProductType
  siteUrl           String?
  adminUrl          String?
  repositoryUrl     String?
  domain            String?
  domainRenewalAt   DateTime?
  hostingProvider   String?
  hostingRenewalAt  DateTime?
  notes             String?
  status            DeliveryStatus       @default(ACTIVE)
  /// Nunca pausar por atraso (produtos próprios e clientes estratégicos)
  neverPause        Boolean              @default(false)
  /// Monitor (2026-10-23): o worker consulta siteUrl (GET/HEAD, só leitura)
  monitorEnabled    Boolean              @default(true)
  monitorStatus     SiteStatus?
  monitorHttpStatus Int?
  monitorResponseMs Int?
  monitorCheckedAt  DateTime?
  monitorDownSince  DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  subscriptions     Subscription[]
  credentials       DeliveryCredential[]
  siteChecks        SiteCheck[]

  @@index([companyId, status])
  @@index([companyId, clientId])
  @@index([companyId, type])
  @@index([companyId, createdAt])
}

enum SiteStatus {
  UP
  DOWN
}

enum CredentialAction {
  CREATE
  UPDATE
  REVEAL
  ARCHIVE
}

/// Login de uma entrega (painel, hospedagem, domínio). A senha fica cifrada
/// (AES-256-GCM); nunca é devolvida na listagem, só em "mostrar" auditado.
model DeliveryCredential {
  id              String                @id @default(cuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deliveryId      String
  delivery        ClientDelivery        @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  label           String
  username        String?
  secretEncrypted String?
  url             String?
  notes           String?
  archivedAt      DateTime?
  createdByUserId String
  createdBy       User                  @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  accessLogs      CredentialAccessLog[]

  @@index([companyId, deliveryId])
}

/// Auditoria imutável de quem criou, alterou, mostrou ou arquivou um login.
model CredentialAccessLog {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  credentialId String
  credential   DeliveryCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  action       CredentialAction
  createdAt    DateTime           @default(now())

  @@index([companyId, credentialId, createdAt])
}

/// Histórico do monitor de sites (retenção curta, limpo pelo worker).
model SiteCheck {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deliveryId String
  delivery   ClientDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  url        String
  ok         Boolean
  httpStatus Int?
  responseMs Int?
  error      String?
  checkedAt  DateTime       @default(now())

  @@index([companyId, deliveryId, checkedAt])
  @@index([checkedAt])
}
