NODE_ENV=development

# API (NestJS)
API_PORT=3001

# Web (Next.js)
WEB_PORT=3000

# Banco de dados
DATABASE_URL=postgresql://postgres:password@localhost:5432/petflow

# Segurança (Etapa 1)
# Allowlist de origens permitidas no CORS (separadas por vírgula)
APP_ORIGINS=http://localhost:3000
# Máximo de tentativas de login por IP+email (janela de 15 minutos)
AUTH_RATE_LIMIT_MAX=5
# Cadastro aberto (N4): limite dedicado por IP. Em produção, restrinja
# (ex.: 3/hora) e avalie verificação de e-mail/captcha antes de habilitar.
REGISTER_RATE_LIMIT_MAX=20
# Rate limit distribuído (Fase 1 · 1C): Redis/Upstash (protocolo redis://
# ou rediss:// com TLS) para produção multi-instância. Ausente = memória
# (zera no restart; vale por instância). Se o Redis cair, a API segue com
# o limite em memória até reconectar.
# REDIS_URL=redis://localhost:6379
# Validade da sessão em horas
AUTH_SESSION_TTL_HOURS=12
# true em produção (cookie Secure); em http local, false
AUTH_COOKIE_SECURE=false
# Redefinição de senha pelo painel (/redefinir-senha).
# true apenas em ambiente local/controllado: a versão atual redefinie sem
# token de e-mail — em produção, mantenha ausente/false (padrão) e exija
# fluxo com token (pendência registrada).
PASSWORD_RESET_ENABLED=true
# Cadastro aberto (/cadastro) — cria empresa nova + administrador em
# PENDING_VERIFICATION; a conta só é ativada pelo link enviado por e-mail
# (Fase 1 · 1D). Em produção exige SMTP_HOST. Recomendado: Turnstile e
# REGISTER_RATE_LIMIT_MAX=3 (por hora, por IP; conta também os sucessos).
REGISTRATION_ENABLED=true

# Bootstrap do primeiro administrador (npm run bootstrap:admin)
# Nunca commite valores reais; preencha apenas no .env local.
BOOTSTRAP_COMPANY_NAME=Empresa Piloto
BOOTSTRAP_COMPANY_SLUG=empresa-piloto
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@exemplo.com
BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-forte

# WhatsApp — Cloud API Meta (Etapa 6)
# Nunca commite valores reais; preencha apenas no .env local.
# WHATSAPP_PROVIDER: meta (Cloud API real) ou mock (padrão em dev/teste)
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_COUNTRY_CODE=55

# Worker — fila de envios do WhatsApp (Etapa 6)
WORKER_POLL_INTERVAL_MS=5000
WHATSAPP_SEND_MAX_PER_CYCLE=20
WHATSAPP_SEND_INTERVAL_MS=250

# Mercado Pago — gateway de cobrança SaaS (Etapa 11, decisão D4)
# Nunca commite valores reais; preencha apenas no .env local.
# Sem ACCESS_TOKEN o checkout retorna erro explícito (nunca cobra por engano).
MERCADOPAGO_ENV=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Backup do banco (Fase 1 · npm run db:backup / db:restore-test)
# Diretório dos dumps (padrão backup/, ignorado pelo Git) e retenção em dias.
BACKUP_DIR=./backup
RETENTION_DAYS=30
# Banco efêmero usado no teste de restore (criado e removido a cada execução)
# RESTORE_TEST_DB=akylla_restore_test
# Diretório dos binários do PostgreSQL, se não estiverem no PATH
# (no Windows o script detecta C:\Program Files\PostgreSQL\<versão>\bin)
# PG_BIN=

# Monitoramento — Sentry (Fase 1 · 1B). Vazio = desligado (nada é enviado).
# API e worker leem SENTRY_DSN; o web (navegador + servidor Next) lê
# NEXT_PUBLIC_SENTRY_DSN (embutido no build — por natureza público).
# Teste de alerta: npm run monitoring:test
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# Fração de requisições com trace de performance (0 a 1)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Profiling contínuo da API (0 = desligado; usa binário nativo)
SENTRY_PROFILES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# E-mail transacional (Fase 1 · 1D) — SMTP via nodemailer (confirmação de
# cadastro e redefinição de senha). Vazio = só log (dev). Nunca commite a senha.
SMTP_HOST=
SMTP_PORT=587
# true para porta 465 (TLS direto); 587 usa STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Akylla Gestão <no-reply@akyllagestao.com.br>
# Validade do link de confirmação de e-mail (horas)
EMAIL_VERIFICATION_TTL_HOURS=24

# Captcha opcional no cadastro (Fase 1 · 1D) — Cloudflare Turnstile.
# Vazio = desligado. A chave do site é pública (vai no build do web); a
# secreta fica só no servidor.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Documentação OpenAPI em /api/docs (Fase 6). Vazio = ligada fora de produção.
API_DOCS_ENABLED=

# Fase 8 — cobrança do SaaS
# Dias de teste grátis para empresas novas (cadastro aberto)
TRIAL_DAYS=14
# E-mails (separados por vírgula) dos donos da plataforma: acesso ao painel
# /plataforma. Em produção a conta precisa ter 2FA ativado.
PLATFORM_ADMIN_EMAILS=
# WhatsApp de vendas exibido em Faturamento (só dígitos, com DDI)
NEXT_PUBLIC_SALES_WHATSAPP=5562981517002

# Anexos da ordem de serviço (Fase 2 · 2.3): pasta no disco (padrão ./uploads,
# ignorada pelo Git). Em produção use um VOLUME PERSISTENTE e faça backup
# dela à parte — os arquivos não estão no dump do banco.
# UPLOADS_DIR=./uploads

# Fiscal por integração (Fase 3). Gere a chave com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ela, token da emissora e certificado A1 não podem ser gravados.
# Trocar a chave invalida os segredos já gravados (cadastre-os de novo).
FISCAL_ENCRYPTION_KEY=
# Segredo do webhook da emissora (assinatura HMAC-SHA256 em x-fiscal-signature)
FISCAL_WEBHOOK_SECRET=
